{
  "name": "hyperbook",
  "version": "0.118.0",
  "author": "Mike Barkmin",
  "homepage": "https://github.com/openpatch/hyperbook#readme",
  "license": "MIT",
  "bin": {
    "hyperbook": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openpatch/hyperbook.git",
    "directory": "packages/hyperbook"
  },
  "bugs": {
    "url": "https://github.com/openpatch/hyperbook/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "version": "pnpm build",
    "lint": "tsc --noEmit",
    "test": "vitest",
    "dev": "ncc build ./index.ts -w -o dist/",
    "build": "rimraf dist && ncc build ./index.ts -o ./dist/ --no-cache --no-source-map-register && node postbuild.mjs"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "jimp": "^1.0.0"
  },
  "devDependencies": {
    "@hyperbook/fs": "workspace:*",
    "@hyperbook/markdown": "workspace:*",
    "@hyperbook/types": "workspace:*",
    "@pnpm/exportable-manifest": "1000.4.2",
    "@types/archiver": "8.0.0",
    "@types/async-retry": "1.4.9",
    "@types/cross-spawn": "6.0.6",
    "@types/lunr": "^2.3.7",
    "@types/node": "26.6.6",
    "@types/prompts": "2.4.9",
    "@types/ws": "^8.18.2",
    "@vercel/ncc": "0.45.0",
    "archiver": "8.0.0",
    "async-retry": "1.3.3",
    "chalk": "6.0.1",
    "chokidar": "6.0.0",
    "commander": "15.0.0",
    "cpy": "13.2.3",
    "create-hyperbook": "workspace:*",
    "cross-spawn": "7.0.6",
    "domutils": "^4.0.2",
    "got": "16.1.0",
    "htmlparser2": "^12.0.0",
    "lunr": "^2.3.9",
    "lunr-languages": "^1.23.0",
    "mime": "^4.1.2",
    "prompts": "2.4.2",
    "rimraf": "6.1.3",
    "tar": "7.5.22",
    "unzipper": "^0.12.5",
    "update-check": "1.5.4",
    "vfile": "^6.0.3",
    "vitest": "^4.1.10",
    "ws": "^8.22.0"
  }
}
