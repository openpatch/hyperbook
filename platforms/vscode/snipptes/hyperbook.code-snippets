      "X: 1",
      "T: ${1:Title}",
      "M: 4/4",
      "L: 1/8",
      "K: ${2:Emin}",
      "$TM_SELECTED_TEXT$0",
      "```"
    ]
  },
  "Element ABC Music Editor": {
    "prefix": [":abc-editor", ":abcjs-editor"],
    "body": [
      "```abcjs editor",
      "X: 1",
      "T: ${1:Title}",
      "M: 4/4",
      "L: 1/8",
      "K: ${2:Emin}",
      "$TM_SELECTED_TEXT$0",
