  "Element Online-IDE": {
    "prefix": [":onlineide"],
    "description": "Java programs that readers edit and run",
    "body": [
      ":::onlineide{height=\"${1:500px}\"}",
      "",
      "```java Main.java",
      "${TM_SELECTED_TEXT:${2:System.out.println(\"Hello\");}}$0",
      "```",
      "",
      ":::"
    ]
  },
  "Element Online-IDE (dock)": {
    "prefix": [":onlineide-dock"],
