{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
        "Language": {
            "enum": [
                "de",
                "en",
                "es",
                "fr",
                "it",
                "nl",
                "pt"
            ],
            "type": "string"
        },
        "Link": {
            "anyOf": [
                {
                    "properties": {
                        "href": {
                            "type": "string"
                        },
                        "icon": {
                            "type": "string"
                        },
                        "label": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "href",
                        "label"
                    ],
                    "type": "object"
                },
                {
                    "properties": {
                        "icon": {
                            "type": "string"
                        },
                        "label": {
                            "type": "string"
                        },
                        "links": {
                            "items": {
                                "$ref": "#/definitions/Link"
                            },
                            "type": "array"
                        }
                    },
                    "required": [
                        "label",
                        "links"
                    ],
                    "type": "object"
                }
            ]
        }
    },
    "properties": {
        "allowDangerousHtml": {
            "type": "boolean"
        },
        "author": {
            "properties": {
                "name": {
                    "type": "string"
                },
                "url": {
                    "type": "string"
                }
            },
            "type": "object"
        },
        "basePath": {
            "type": "string"
        },
        "breadcrumb": {
            "anyOf": [
                {
                    "properties": {
                        "home": {
                            "type": "string"
                        },
                        "separator": {
                            "type": "string"
                        }
                    },
                    "type": "object"
                },
                {
                    "type": "boolean"
                }
            ]
        },
        "cloud": {
            "properties": {
                "id": {
                    "type": "string"
                },
                "url": {
                    "type": "string"
                }
            },
            "required": [
                "id",
                "url"
            ],
            "type": "object"
        },
        "colors": {
            "properties": {
                "brand": {
                    "format": "color-hex",
                    "type": "string"
                },
                "brandDark": {
                    "format": "color-hex",
                    "type": "string"
                },
                "brandText": {
                    "format": "color-hex",
                    "type": "string"
                },
                "inverted": {
                    "type": "boolean"
                }
            },
            "type": "object"
        },
        "description": {
            "type": "string"
        },
        "elements": {
            "allOf": [
                {
                    "properties": {
                        "bookmarks": {
                            "anyOf": [
                                {
                                    "additionalProperties": {},
                                    "properties": {
                                        "cdn": {
                                            "description": "Serve the assets of this element from a CDN instead of copying them into\nyour build. `true` uses jsDelivr, pinned to the version of hyperbook that\nbuilt your pages, so the assets always match the pages that ask for them.\nA URL uses a mirror of your own.\n\nAn element served this way needs the network, so leave it off for the ones\nyou want working offline.",
                                            "type": [
                                                "string",
                                                "boolean"
                                            ]
                                        },
                                        "version": {
                                            "type": "string"
                                        }
                                    },
                                    "type": "object"
                                },
                                {
                                    "const": false,
                                    "type": "boolean"
                                }
                            ]
                        },
                        "code": {
                            "allOf": [
                                {
                                    "additionalProperties": {},
                                    "properties": {
                                        "cdn": {
                                            "description": "Serve the assets of this element from a CDN instead of copying them into\nyour build. `true` uses jsDelivr, pinned to the version of hyperbook that\nbuilt your pages, so the assets always match the pages that ask for them.\nA URL uses a mirror of your own.\n\nAn element served this way needs the network, so leave it off for the ones\nyou want working offline.",
                                            "type": [
                                                "string",
                                                "boolean"
                                            ]
                                        },
                                        "version": {
                                            "type": "string"
                                        }
                                    },
                                    "type": "object"
                                },
                                {
                                    "properties": {
                                        "bypassInline": {
                                            "type": "boolean"
                                        },
                                        "showLineNumbers": {
                                            "type": "boolean"
                                        },
                                        "theme": {
                                            "anyOf": [
                                                {
                                                    "properties": {
                                                        "dark": {
                                                            "type": "string"
                                                        },
                                                        "light": {
                                                            "type": "string"
                                                        }
                                                    },
                                                    "required": [
                                                        "dark",
                                                        "light"
                                                    ],
                                                    "type": "object"
                                                },
                                                {
                                                    "type": "string"
                                                }
                                            ]
                                        }
                                    },
                                    "type": "object"
                                }
                            ]
                        },
                        "emoji": {
                            "allOf": [
                                {
                                    "additionalProperties": {},
                                    "properties": {
                                        "cdn": {
                                            "description": "Serve the assets of this element from a CDN instead of copying them into\nyour build. `true` uses jsDelivr, pinned to the version of hyperbook that\nbuilt your pages, so the assets always match the pages that ask for them.\nA URL uses a mirror of your own.\n\nAn element served this way needs the network, so leave it off for the ones\nyou want working offline.",
                                            "type": [
                                                "string",
                                                "boolean"
                                            ]
                                        },
                                        "version": {
                                            "type": "string"
                                        }
                                    },
                                    "type": "object"
                                },
                                {
                                    "properties": {
                                        "style": {
                                            "description": "How emojis are rendered.\n- \"native\": Emojis are kept as text and drawn with the emoji font of\n  the reader's operating system (default).\n- \"twemoji\": Emojis are replaced with Twemoji images, so they look the\n  same on every platform.",
                                            "enum": [
                                                "native",
                                                "twemoji"
                                            ],
                                            "type": "string"
                                        }
                                    },
                                    "type": "object"
                                }
                            ]
                        },
                        "excalidraw": {
                            "allOf": [
                                {
                                    "additionalProperties": {},
                                    "properties": {
                                        "cdn": {
                                            "description": "Serve the assets of this element from a CDN instead of copying them into\nyour build. `true` uses jsDelivr, pinned to the version of hyperbook that\nbuilt your pages, so the assets always match the pages that ask for them.\nA URL uses a mirror of your own.\n\nAn element served this way needs the network, so leave it off for the ones\nyou want working offline.",
                                            "type": [
                                                "string",
                                                "boolean"
                                            ]
                                        },
                                        "version": {
                                            "type": "string"
                                        }
                                    },
                                    "type": "object"
                                },
                                {
                                    "properties": {
                                        "aspectRatio": {
                                            "type": "string"
                                        },
                                        "autoZoom": {
                                            "type": "boolean"
                                        },
                                        "center": {
                                            "type": "boolean"
                                        },
                                        "edit": {
                                            "type": "boolean"
                                        }
                                    },
                                    "type": "object"
                                }
                            ]
                        },
                        "kirimoto": {
                            "allOf": [
                                {
                                    "additionalProperties": {},
                                    "properties": {
                                        "cdn": {
                                            "description": "Serve the assets of this element from a CDN instead of copying them into\nyour build. `true` uses jsDelivr, pinned to the version of hyperbook that\nbuilt your pages, so the assets always match the pages that ask for them.\nA URL uses a mirror of your own.\n\nAn element served this way needs the network, so leave it off for the ones\nyou want working offline.",
                                            "type": [
                                                "string",
                                                "boolean"
                                            ]
                                        },
                                        "version": {
                                            "type": "string"
                                        }
                                    },
                                    "type": "object"
                                },
                                {
                                    "properties": {
                                        "height": {
                                            "type": "string"
                                        },
                                        "settings": {
                                            "type": "string"
                                        }
                                    },
                                    "type": "object"
                                }
                            ]
                        },
                        "onlineide": {
                            "allOf": [
                                {
                                    "additionalProperties": {},
                                    "properties": {
                                        "cdn": {
                                            "description": "Serve the assets of this element from a CDN instead of copying them into\nyour build. `true` uses jsDelivr, pinned to the version of hyperbook that\nbuilt your pages, so the assets always match the pages that ask for them.\nA URL uses a mirror of your own.\n\nAn element served this way needs the network, so leave it off for the ones\nyou want working offline.",
                                            "type": [
                                                "string",
                                                "boolean"
                                            ]
                                        },
                                        "version": {
                                            "type": "string"
                                        }
                                    },
                                    "type": "object"
                                },
                                {
                                    "properties": {
                                        "height": {
                                            "type": [
                                                "string",
                                                "number"
                                            ]
                                        }
                                    },
                                    "type": "object"
                                }
                            ]
                        },
                        "sqlide": {
                            "allOf": [
                                {
                                    "additionalProperties": {},
                                    "properties": {
                                        "cdn": {
                                            "description": "Serve the assets of this element from a CDN instead of copying them into\nyour build. `true` uses jsDelivr, pinned to the version of hyperbook that\nbuilt your pages, so the assets always match the pages that ask for them.\nA URL uses a mirror of your own.\n\nAn element served this way needs the network, so leave it off for the ones\nyou want working offline.",
                                            "type": [
                                                "string",
                                                "boolean"
                                            ]
                                        },
                                        "version": {
                                            "type": "string"
                                        }
                                    },
                                    "type": "object"
                                },
                                {
                                    "properties": {
                                        "db": {
                                            "type": "string"
                                        },
                                        "height": {
                                            "type": [
                                                "string",
                                                "number"
                                            ]
                                        }
                                    },
                                    "type": "object"
                                }
                            ]
                        }
                    },
                    "type": "object"
                },
                {
                    "additionalProperties": {
                        "anyOf": [
                            {
                                "additionalProperties": {},
                                "properties": {
                                    "cdn": {
                                        "description": "Serve the assets of this element from a CDN instead of copying them into\nyour build. `true` uses jsDelivr, pinned to the version of hyperbook that\nbuilt your pages, so the assets always match the pages that ask for them.\nA URL uses a mirror of your own.\n\nAn element served this way needs the network, so leave it off for the ones\nyou want working offline.",
                                        "type": [
                                            "string",
                                            "boolean"
                                        ]
                                    },
                                    "version": {
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            },
                            {
                                "const": false,
                                "type": "boolean"
                            }
                        ]
                    },
                    "type": "object"
                }
            ]
        },
        "font": {
            "type": "string"
        },
        "fonts": {
            "properties": {
                "body": {
                    "type": "string"
                },
                "code": {
                    "type": "string"
                },
                "heading": {
                    "type": "string"
                }
            },
            "type": "object"
        },
        "importExport": {
            "type": "boolean"
        },
        "language": {
            "$ref": "#/definitions/Language"
        },
        "license": {
            "type": "string"
        },
        "links": {
            "items": {
                "$ref": "#/definitions/Link"
            },
            "type": "array"
        },
        "llms": {
            "type": "boolean"
        },
        "logo": {
            "type": "string"
        },
        "name": {
            "type": "string"
        },
        "qrcode": {
            "type": "boolean"
        },
        "repo": {
            "anyOf": [
                {
                    "properties": {
                        "label": {
                            "type": "string"
                        },
                        "url": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "label",
                        "url"
                    ],
                    "type": "object"
                },
                {
                    "type": "string"
                }
            ]
        },
        "scripts": {
            "items": {
                "type": "string"
            },
            "type": "array"
        },
        "search": {
            "type": "boolean"
        },
        "styles": {
            "items": {
                "type": "string"
            },
            "type": "array"
        },
        "toc": {
            "type": "boolean"
        },
        "trailingSlash": {
            "type": "boolean"
        },
        "version": {
            "description": "Controls how the Hyperbook version is displayed.\n- \"text\": Shows version below the \"Powered by Hyperbook\" label.\n- \"tooltip\": Shows version on hover of the \"Powered by Hyperbook\" label.\n- \"console\": Outputs version as ASCII art in the browser console (default).",
            "enum": [
                "console",
                "text",
                "tooltip"
            ],
            "type": "string"
        }
    },
    "required": [
        "name"
    ],
    "type": "object"
}

