# Copy to .env and edit. In production the server refuses to start until
# JWT_SECRET and BASE_URL are set, rather than running insecurely in silence.

# === Required in production ===

# Signs every session token. Anyone who knows it can mint a token for any
# account, so keep it private and specific to this deployment. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# The address readers actually use. Password reset links are built from it, and
# it is the origin hyperbooks are allowed to sync from.
BASE_URL=http://localhost:3001

# === Server ===

PORT=3001
NODE_ENV=development

# Ignored under Docker Compose, which keeps the database on a named volume.
DATABASE_PATH=./database.sqlite

JWT_EXPIRES_IN=24h

# === First run only ===

# Used to create the initial admin account. Changing them later has no effect;
# change the password from the admin interface instead.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# === Email, for password resets (optional) ===

# Leave all of these empty to disable email. Setting only some of them is
# rejected in production, because half a configuration silently sends nothing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
