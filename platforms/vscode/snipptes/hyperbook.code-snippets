  "Element Tile": {
    "prefix": [":tile"],
    "description": "One tile inside :::tiles",
    "body": ["::tile{title=\"${1:Title}\" href=\"${2:/page}\"}"]
  },
  "Element PDF": {
    "prefix": [":pdf"],
    "description": "A PDF document on the page; a .typ source is built into one",
    "body": ["::pdf[${1:Title}]{src=\"${2:document.pdf}\"}"]
  },
  "Element Password List": {
    "prefix": [":passwordlist"],
    "description": "The passwords of the book, for the teacher's page",
