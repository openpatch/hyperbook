{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "description": "Contents of passwords.json.\n\nKeep this file out of version control if the book is public — it holds the\nactual passwords. Values can also come from the environment; see the\n`hyperbook passwords` documentation.",
    "properties": {
        "$schema": {
            "type": "string"
        },
        "passwords": {
            "additionalProperties": {
                "anyOf": [
                    {
                        "description": "One named password in the registry.",
                        "properties": {
                            "description": {
                                "type": "string"
                            },
                            "name": {
                                "description": "Label shown by `hyperbook passwords` and the passwordlist directive.",
                                "type": "string"
                            },
                            "value": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "value"
                        ],
                        "type": "object"
                    },
                    {
                        "type": "string"
                    }
                ]
            },
            "description": "The bare string form is shorthand for `{ \"value\": \"...\" }`.",
            "type": "object"
        }
    },
    "required": [
        "passwords"
    ],
    "type": "object"
}

