# Copy to .env and edit. In production the server refuses to start until the
# required values are set, rather than running insecurely in silence.

# === Required in production ===

# Where teachers and admins open Hyperbook Cloud. An origin only, no path.
ADMIN_ORIGIN=https://cloud.example.org

# Books are served at https://<slug>.<BOOKS_DOMAIN>, so this needs a wildcard
# DNS record (*.example.page) pointing at this server.
#
# Books contain scripts written by teachers. Best is a separate registered
# domain just for books (example.page next to example.org), so nothing a book
# does can touch the admin site. A subdomain such as books.example.org also
# works, as does the admin host itself (admin on example.org, books on
# <slug>.example.org). The host of ADMIN_ORIGIN must not lie inside BOOKS_DOMAIN.
BOOKS_DOMAIN=example.page

# Encrypts student passwords and QR login keys, so teachers can reprint their
# credential lists. Keep it with your backups: without it, stored credentials
# cannot be shown again (students can still log in). Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_KEY=

# === First run only ===

# Creates the first admin account. Changing these later has no effect.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# === Email, for password resets (optional) ===

# Leave all of these empty to disable email. Setting only some of them is
# rejected, because half a configuration silently sends nothing.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Development only: write emails as files into this folder instead of sending
# them (instead of SMTP_*).
# MAIL_OUTBOX_DIR=./data/outbox

# === AI writing assistant (optional) ===

# Leave all of these empty to disable the assistant. Setting only some of
# them is rejected, because half a configuration silently sends nothing.
# The API key never reaches the browser.
# Mistral (documented default; key from console.mistral.ai):
# AI_BASE_URL=https://api.mistral.ai/v1
# AI_API_KEY=
# AI_MODEL=mistral-medium-latest      # or mistral-small-latest, open-mistral-nemo
# Comma-separated extra models the editor offers to pick from (AI_MODEL stays
# the default): AI_MODELS=mistral-small-latest,open-mistral-nemo
# Any other OpenAI-compatible endpoint works the same way, e.g. a local
# Ollama: AI_BASE_URL=http://localhost:11434/v1, AI_API_KEY=ollama (ignored
# by Ollama, but required), AI_MODEL=<pulled model>.
# AI_TIMEOUT_SECONDS=120
# AI_MAX_OUTPUT_TOKENS=2048
# AI_MAX_STEPS=8
# AI_REQUESTS_PER_MINUTE=6

# === Uploads and builds (optional) ===

# Largest accepted zip, and largest unpacked book (and built book), in MB.
UPLOAD_MAX_MB=100
BOOK_MAX_MB=500

# How many books build at the same time, how long a build may take, and how
# much memory (heap) one build may use.
BUILD_CONCURRENCY=1
BUILD_TIMEOUT_SECONDS=300
BUILD_MEMORY_MB=1024
# After an update, rebuild published books made with another Hyperbook version
# (in the background, after teachers' own builds).
# REBUILD_ON_UPGRADE=true

# === Student data (optional) ===

# Largest saved state of one student in one book, in MB, and after how many
# changes they are folded into one snapshot.
STORE_MAX_MB=10
STORE_COMPACT_EVENTS=100
