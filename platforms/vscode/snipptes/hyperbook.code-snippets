{
  "Element Alert": {
    "prefix": [":alert"],
    "body": [
      ":::alert{${1|info,success,error,warn|}}",
      "",
      "$TM_SELECTED_TEXT$0",
      "",
      ":::"
    ]
  },
  "Element Download": {
    "prefix": [":download"],
    "body": ["::download[${2:title}]{src=\"$1\"}", "$0"]
  },
  "Element H5P": {
    "prefix": [":h5p"],
    "body": ["::h5p{src=\"$1\"}", "$0"]
  },
  "Element Archive": {
    "prefix": [":archive"],
    "body": ["::archive[${2:title}]{name=\"$1\"}", "$0"]
  },
  "Element Bookmarks": {
    "prefix": [":bookmarks"],
    "body": ["::bookmarks", "", "$0"]
  },
  "Element Collapsible": {
    "prefix": [":collapsible"],
    "body": [
      ":::collapsible{title=\"${1:title}\" id=\"${2:$RANDOM}\"}",
      "",
      "$TM_SELECTED_TEXT",
      "$0",
      ":::"
    ]
  },
  "Element Excalidraw": {
    "prefix": [":excalidraw"],
    "body": [
      "::excalidraw{src=\"$1\" aspectRatio=\"${2:16/9}\" autoZoom=${3:true} edit=${4:false}}",
      "",
      "$0"
    ]
  },
  "Element Excalidraw (dock)": {
    "prefix": [":excalidraw-dock"],
    "description": "Readers can move it into the dock beside the text; dock=\"Label\" names its tab",
    "body": [
      "::excalidraw{src=\"$1\" aspectRatio=\"${2:16/9}\" autoZoom=${3:true} edit=${4:false} dock}",
      "",
      "$0"
    ]
  },
  "Element Glossary": {
    "prefix": [":t", ":term"],
    "body": [":t[$2]{#${1:id}}$0"]
  },
  "Element Mermaid": {
    "prefix": [":mermaid"],
    "body": [":::mermaid", "$0", ":::"]
  },
  "Element Protect": {
    "prefix": [":protect"],
    "body": [
      ":::protect{password=\"${1:password}\" description=\"${2:description}\"}",
      "",
      "$TM_SELECTED_TEXT$0",
      "",
      ":::"
    ]
  },
  "Element QR": {
    "prefix": [":qr"],
    "body": [
      "::qr{value=\"$CLIPBOARD\" size=\"${2|S,M,L,XL|}\" label=\"$3\"}",
      "$0"
    ]
  },
  "Element Struktog": {
    "prefix": [":struktog"],
    "body": ["::struktog{data=\"$CLIPBOARD\"}", "$0"]
  },
  "Element Struktolab": {
    "prefix": [":struktolab"],
    "description": "A structogram from pseudocode",
    "body": [
      ":::struktolab{mode=\"${1|preview,edit|}\"}",
      "",
      "```",
      "$TM_SELECTED_TEXT$0",
      "```",
      "",
      ":::"
    ]
  },
  "Element Struktolab (dock)": {
    "prefix": [":struktolab-dock"],
    "description": "Readers can move it into the dock beside the text; dock=\"Label\" names its tab",
    "body": [
      ":::struktolab{mode=\"${1|edit,preview|}\" dock}",
      "",
      "```",
      "$TM_SELECTED_TEXT$0",
      "```",
      "",
      ":::"
    ]
  },
  "Element Struktolab Code": {
    "prefix": [":struktolab-code"],
    "description": "A structogram from Java, Python or JavaScript; hideCode shows the diagram alone in edit mode",
    "body": [
      ":::struktolab{mode=\"${1|edit,preview|}\"${2: hideCode}}",
      "",
      "```${3|java,python,javascript|}",
      "$TM_SELECTED_TEXT$0",
      "```",
      "",
      ":::"
    ]
  },
  "Element Tabs": {
    "prefix": [":tabs"],
    "body": [
      "::::tabs{id=\"$RANDOM\"}",
      "",
      ":::tab{title=\"${1:Tab 1}\" id=\"$RANDOM\"}",
      "",
      "$TM_SELECTED_TEXT$0",
      "",
      ":::",
      "",
      "::::"
    ]
  },
  "Element Tab": {
    "prefix": [":tab"],
    "body": [
      ":::tab{title=\"${1:title}\" id=\"$RANDOM\"}",
      "",
      "$TM_SELECTED_TEXT$0",
      "",
      ":::"
    ]
  },
  "Element Tiles": {
    "prefix": [":tiles"],
    "body": [
      ":::tiles",
      "",
      "::tile{title=\"${1:Tab 1}\" href=\"$RANDOM\"}",
      "",
      "$0",
      "",
      ":::"
    ]
  },
  "Element YouTube": {
    "prefix": [":youtube"],
    "body": ["::youtube[${1:title}]{#$CLIPBOARD}", "$0"]
  },
  "Element Embed": {
    "prefix": [":embed"],
    "body": ["::embed{src=\"$CLIPBOARD\"}", "$0"]
