    "extrudeAbs": false,
    "spindleMax": 0,
    "gcodeFan": [
        "M106 S{fan_speed}"
    ],
    "gcodeTrack": [
        "M73 P{progress}"
    ],
    "gcodeLayer": [
        ";; LAYER {layer} of {layers}",
        "M117 Layer {layer} of {layers}"
    ],
    "gcodePre": [
        "G21                ; set units to millimeters",
        "G90                ; use absolute coordinates",
        "M83                ; use relative distances for extruder",
        "M106 S0           ; turn off cooling fan",
        "G92 E0            ; zero the extruded length",
        "G1 F1800          ; set feedrate",
        "M104 S{temp}      ; set extruder temp",
        "M140 S{bed_temp}  ; set bed temp",
        "M190 S{bed_temp}  ; wait for bed temp",
        "M109 S{temp}      ; wait for extruder temp",
        "G28               ; home all axes",
        "G1 Z15.0 F6000    ; move nozzle away from bed",
        "G1 X0 Y0          ; move to origin",
        "G1 Z0.3           ; lower nozzle to first layer height",
        "G92 E0            ; zero the extruded length again",
        "G1 E5 F50        ; purge a little filament",
        "G92 E0            ; zero the extruded length again",
        "M117 Printing..."
    ],
    "gcodePost": [
        "M104 S0           ; turn off extruder",
        "M140 S0           ; turn off bed",
        "M106 S0           ; turn off fan",
        "G1 E-1 F300       ; retract filament",
        "G1 Z10 F3000      ; raise Z",
        "G28 X Y           ; home X and Y",
        "M84               ; disable steppers",
        "M117 Print Done"
    ],
