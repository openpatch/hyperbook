    "prefix": [":file"],
    "description": "A file of the book handed to an IDE (pyide, webide, p5, typst, openscad)",
    "body": ["::file{src=\"${1:/data.csv}\" dest=\"${2:data.csv}\"}"]
  },
  "Element Scratch Blocks": {
    "prefix": [":scratchblock"],
    "description": "Scratch code drawn as blocks",
    "body": [
      ":::scratchblock",
      "${TM_SELECTED_TEXT:${1:when green flag clicked}}$0",
      ":::"
    ]
  },
  "Element Blockflow Player": {
    "prefix": [":blockflow-player"],
    "description": "Plays a Scratch project",
    "body": ["::blockflow-player{src=\"${1:/project.sb3}\"}"]
