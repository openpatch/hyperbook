exports[`remarkDirectiveOpenscad > should transform basic openscad 1`] = `
"
<div class="directive-openscad" data-id="eb541cd756411e88163c5bf0e21aa54ad33d3bceb8a95721bff82640f32d1f12" data-binary-files="W10=" data-base-path="/" data-page-path="">
